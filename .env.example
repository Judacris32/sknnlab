# Public URL of the live site (used for SEO, sitemap and social previews)
NEXT_PUBLIC_SITE_URL=https://sknnlab.com

# Resend (https://resend.com) – sends booking and contact emails
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Where booking requests and contact messages are delivered
CLINIC_INBOX_EMAIL=Sknnlab@gmail.com

# The "from" address. Until the clinic's domain is verified in Resend, use
# onboarding@resend.dev (Resend then only delivers to your own Resend account email).
EMAIL_FROM="SKNN LAB <bookings@sknnlab.com>"

# Optional: Google Apps Script web-app URL that appends each booking to a Google Sheet.
# Leave empty to skip. See README → "Google Sheet backup".
GOOGLE_SHEETS_WEBHOOK_URL=
